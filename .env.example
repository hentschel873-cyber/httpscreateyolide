# Example environment variables for local-sync integration
# ============================================================
# Copy this file to .env.local and fill in your values
# Do NOT commit .env.local to version control!
#
# For detailed setup instructions, see: ENV_SETUP.md
# ============================================================

# Required: Shared secret for local-sync REST API authentication
# Generate with: openssl rand -base64 32
LOCAL_SYNC_SECRET=replace_with_a_strong_secret_here

# Server-side authentication (should match LOCAL_SYNC_SECRET)
WP_LOCAL_SYNC_SECRET=${LOCAL_SYNC_SECRET}

# Optional: Comma-separated IP whitelist (supports CIDR notation)
# Examples: 127.0.0.1,::1 or 192.168.1.0/24
# WP_LOCAL_SYNC_WHITELIST=127.0.0.1,::1

# Optional: Rate limit (requests per minute per IP), default: 60
# WP_LOCAL_SYNC_RATE_LIMIT=60

# Optional: Trust proxy headers (X-Forwarded-For), set to 1 if behind proxy
# WP_LOCAL_SYNC_TRUST_PROXY=0

# Optional: Enable debug logging (1=enabled, 0=disabled), default: 0
# WARNING: Only enable in development!
# WP_LOCAL_SYNC_DEBUG=0

# ============================================================
# Quick Start:
# 1. cp .env.example .env.local
# 2. openssl rand -base64 32
# 3. Replace LOCAL_SYNC_SECRET value above with generated token
# 4. Load: export $(grep -v '^#' .env.local | xargs)  # Bash
#    OR: Get-Content .env.local | ForEach-Object { ... }  # PowerShell
# 5. Validate: bash scripts/validate_env_vars.sh
#
# For more details, see ENV_SETUP.md
# ============================================================
