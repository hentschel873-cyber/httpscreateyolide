# Example environment variables for local-sync integration
# Copy values into your hosting/CI secrets or create a local .env (do NOT commit real secrets)

# Shared secret used by local-sync clients (e.g. scripts/local-sync/ping.js)
LOCAL_SYNC_SECRET=replace_with_a_strong_secret_here

# (Optional) also used by server-side verifier if configured
WP_LOCAL_SYNC_SECRET=${LOCAL_SYNC_SECRET}
